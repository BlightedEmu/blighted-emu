{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlightedLauncher",
  "identifier": "io.github.blightedemu.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blighted New World launcher",
        "width": 1080,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Blighted New World",
    "shortDescription": "Blighted New World launcher",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BlightedEmu/blighted-emu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDQTc4MEFGMTVEMzI1QUIKUldTckpkTVZyNENuM0NBeTFueCtPZy8ranpZN1h2KzNPNlBmOTNXKzV0aHliTnp0OWRNcVNremwK"
    }
  }
}
