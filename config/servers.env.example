# Every environment variable that the game servers read. Copy this file to
# local-data/m3-test.env (local-data/ is never committed) and set real values. scripts/live-stack.sh
# loads that file before it starts each server. For your own start scripts, load it with
#   set -a; . local-data/m3-test.env; set +a
# For systemd, name it in each unit: EnvironmentFile=/path/to/local-data/m3-test.env
# Never commit a copy with real values.
#
# The servers read every other setting from their file in config/. Any key of those files can
# also be set here, with the server's prefix and the key in capitals. Join the keys of a section
# with "__", for example NW_SIM_COMBAT__LOOT_DROP_MULTIPLIER=2.0. The prefixes:
#   edge-http       NW_EDGE_       config/edge.toml
#   rep-gateway     NW_GATEWAY_    config/rep-gateway.toml
#   world-director  NW_DIRECTOR_   config/world-director.toml
#   sim             NW_SIM_        config/sim.toml
#   social          NW_SOCIAL_     config/social.toml
#   voice-server    NW_VOICE_      config/voice-server.toml
#   status-reporter NW_REPORTER_   config/status-reporter.toml
#   blighted-admin  BLIGHTED_ADMIN_        config/blighted-admin.toml
#   admin relay     BLIGHTED_ADMIN_RELAY_  config/blighted-admin-relay.toml
#   nw-testclient   NW_TESTCLIENT_ config/nw-testclient.toml
#   client build    NW_CLIENT_     config/client-build.toml (read by every server)
# A variable with one of these prefixes that names no key stops the server at its start. The
# value is read like a TOML value, so 123 is a number and true is a yes/no value. To give a text
# key a value that looks like a number, put quotes inside the value: NW_SIM_SIM_ID='"123"'.

# Secrets. Each name must start with NW_SECRET_. A config file names some of these variables
# (keys that end in _env); the names below are the ones the example files use.

# The key that signs the entry tickets: hex, 32 bytes or more. edge-http and rep-gateway need
# the same key. Make one with: openssl rand -hex 32
NW_SECRET_SIGNING_KEY=change-me-run-openssl-rand-hex-32
# The password of the global database (accounts, staff ranks, store, leaderboards). Read by
# edge-http, sim, world-director, status-reporter, and by social and the admin site when their
# global database section is set. With the Docker databases of deploy/, it is POSTGRES_PASSWORD
# of deploy/.env.
NW_SECRET_GLOBAL_DATABASE_PASSWORD=change-me-postgres
# The password of the first world's database. Read by edge-http, sim, world-director, social
# and status-reporter. A second world names its own variable in its database_password_env.
NW_SECRET_WORLD_1_DATABASE_PASSWORD=change-me-postgres
# The client secret of your Discord application. Needed only for [auth] mode = "discord" in
# config/edge.toml, and for the Discord login of the admin site.
# NW_SECRET_DISCORD_CLIENT_SECRET=
# The report secret of this world on the website: 32 characters or more (openssl rand -hex 32).
# It is the same text as the third part of this world's WORLDS entry on the website. Needed only
# for status-reporter.
# NW_SECRET_STATUS_REPORT_SECRET=
# The key that signs the voice login tokens. The social service and the voice server need the
# same key. Needed only for voice chat.
# NW_SECRET_VOICE_KEY=

# Folders.

# The content folder: the game data that `just content` builds (README.md, "Content data").
# Read by sim, world-director, edge-http, status-reporter, blighted-admin, nw-testclient and
# content-tool. A relative path starts at the folder the server runs in. Left out, it is
# local-data/content.
NW_CONTENT_DIR=local-data/content
# The New World game install folder. content-tool reads the game files from it, and the admin
# site reads typeindex.json from it. The servers do not need it (social names its own game_dir).
NW_GAME_DIR=/path/to/steamapps/common/New World
# The Server.pak of the pinned client build, for `content-tool ai-data` (the mob AI data). Get it
# with a depot download of the build. Never share or commit it. Left out, it is
# local-data/server-pak/Server.pak.
# NW_SERVER_PAK=local-data/server-pak/Server.pak

# Debug switches of the sim. Leave them unset on a server that players use.

# When set, the sim sends every world update as a reliable message. One lost packet then holds
# back every update after it until the packet comes again, so players see stalls. The open-world
# sims of the project's own game server run without it.
# NW_RELIABLE_BUNDLES=1
# When set, the sim sends each player only its own position and no other player, mob or object.
# It is only for tracing a fault in the world updates.
# NW_POSITIONS_ONLY=1

# Test tools only (nw-testclient and the bot batches of the admin site's live panel).

# The password of the test account, and of a second test account for `nw-testclient pair`.
# NW_SECRET_TESTCLIENT_PASSWORD=
# NW_SECRET_TESTCLIENT_PASSWORD_B=
# The password of every bot account (`nw-testclient swarm`, `hunt` and `gather`).
# NW_SECRET_TESTCLIENT_SWARM_PASSWORD=
