# Build output
/target/

# Secrets for the infrastructure (copy from deploy/.env.example)
/deploy/.env

# Local Amazon game data and captures (spec 10.2). Never commit these.
/local-data/

# Game files and decoded client data. scripts/no-game-data.sh refuses these.
*.pak
*.datasheet
*.loc.xml
*.dds
*.DDS
typeindex.json

# Capture ledgers (`nw-testclient --ledger`, recorded sessions): other players' data, or the
# login token of our own test session. scripts/no-game-data.sh refuses these too.
ledger.bin

# Ghidra projects and exported decompiler listings.
*.gpr
*.rep/
*.gbf
decompiled/

# =============================================================================
# Secrets and signing material: never commit
# =============================================================================

.env
.env.*
# Templates without secrets are always kept.
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
# Throwaway test fixtures, no real secret: the launcher proxy's own game-facing key (the patched
# client never checks it) and a stand-in server mirror key for the proxy tests.
!bins/launcher/testdata/proxy-tls-key.pem
!bins/launcher/testdata/proxy-mirror-key.pem

