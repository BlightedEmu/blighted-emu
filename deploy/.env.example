# Copy to deploy/.env and change every password before use.
# deploy/.env is listed in .gitignore and is never committed.
POSTGRES_USER=nw
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=nw_global
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Address the published ports bind to. Keep 127.0.0.1 unless remote access is required.
BIND_ADDRESS=127.0.0.1
